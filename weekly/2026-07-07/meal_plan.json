  "batch_prep": [
    {
      "station": "Sunday — Egg Bites Batch (35 min, covers Mon–Thu breakfasts)",
      "tasks": [
        "Preheat oven to 350°F. Spray 12-cup muffin tin well.",
        "Cook 8 oz ground turkey with garlic powder, onion powder, smoked paprika, salt in a skillet until no pink remains. Drain.",
        "Finely dice 1 zucchini. Squeeze between paper towels to remove moisture.",
        "Whisk 8 egg whites + 4 whole eggs + 2 tbsp chipotle adobo sauce + salt/pepper.",
        "Fill each muffin cup with turkey + zucchini. Pour egg mixture over. Top with shredded cheddar.",
        "Bake 22–25 min until set. Cool 5 min. Run knife around edges. Store in fridge up to 5 days.",
        "Austin: 3 bites per morning. Cameron: 3 bites + 1/2 avocado on the side."
      ]
    },
    {
      "station": "Sunday — Smoker: Bone-In Thighs (2–2.5 hrs, hands-off)",
      "tasks": [
        "Apply dry rub to all thighs: smoked paprika, garlic powder, onion powder, brown sugar, chipotle powder, cumin, salt, pepper. Rub in well.",
        "Set smoker to 250°F with applewood or hickory chips.",
        "Smoke skin-side up 2–2.5 hrs until internal temp hits 175°F. Don't rush it.",
        "Optional: 5 min under broiler at end for crispy skin.",
        "Cool and refrigerate. Thursday dinner = 2 thighs per person. Friday = pull meat off bone for grain bowls."
      ]
    },
    {
      "station": "Sunday — Chicken Salad Assembly (10 min)",
      "tasks": [
        "Dice 3 celery stalks + 1/4 cup red onion finely.",
        "Whisk dressing: 1/2 cup Greek yogurt + 2 tbsp Dijon + 1 tbsp ACV + 1 tsp honey + dill + parsley.",
        "Fold dressing into ALREADY-SHREDDED chicken breast. Taste and adjust.",
        "Portion into 4 containers. Keep arugula SEPARATE — dress day-of so it doesn't wilt.",
        "Austin: red pepper flakes + lemon squeeze at serving. Cameron: + sliced avocado."
      ]
    },
    {
      "station": "Sunday — Chipotle Bowl Components (20 min)",
      "tasks": [
        "Cook 3 cups brown rice. Toss with lime juice and cilantro while warm. Batch for 4 dinner servings.",
        "Char corn in dry cast-iron or on grill. Make pico: diced tomato, jalapeño, red onion, cilantro, lime.",
        "Warm ALREADY-PREPPED chipotle chicken thighs in skillet with splash of water. Season with cumin + smoked paprika.",
        "Portion rice + chicken + black beans + corn + pico into 4 containers.",
        "Make extra pico — you'll use it Friday for soba bowl and shrimp wraps."
      ]
    },
    {
      "station": "Sunday — Teriyaki Sauce for Tuesday (10 min)",
      "tasks": [
        "Combine in small saucepan: 1/4 cup soy sauce + 2 tbsp honey + 1 tbsp rice vinegar + 1 tsp sesame oil + 1 tsp grated ginger + 2 cloves minced garlic.",
        "Bring to simmer, stir in cornstarch slurry (1 tbsp cornstarch + 2 tbsp water). Cook 2 min until glossy.",
        "Cool and refrigerate in a jar. Tuesday: cook soba noodles, rinse cold, use leftover smoked chicken, toss with sauce. Done in 15 min."
      ]
    }
  ]
}