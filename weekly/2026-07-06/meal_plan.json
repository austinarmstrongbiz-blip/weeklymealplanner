  "batch_prep": [
    {
      "station": "Saturday \u2014 Egg Bites Batch (25 min)",
      "tasks": [
        "Whisk 8 eggs with milk, salt, pepper, garlic powder.",
        "Brown turkey sausage, wilt spinach in same pan.",
        "Divide sausage/spinach into greased muffin tin, top with cheddar, pour egg mixture over.",
        "Bake 350\u00b0F for 18-20 min. Cool, store in fridge up to 5 days (covers all 7 breakfasts)."
      ]
    },
    {
      "station": "Saturday \u2014 Teriyaki Bone-In Chicken Thighs (45 min)",
      "tasks": [
        "Whisk teriyaki glaze: soy sauce, honey, rice vinegar, garlic, ginger, sesame oil.",
        "Season bone-in thighs, brush with glaze, bake at 400\u00b0F for 35-40 min, brushing halfway.",
        "Cook soba noodles, rinse under cold water to stop cooking and prevent clumping.",
        "Once cooled, remove skin/bones, slice meat. Portion into 4 containers (2 dinners x 2 people) with cold soba, snap peas/cucumber, scallions, sesame seeds."
      ]
    },
    {
      "station": "Sunday \u2014 Chicken Salad Assembly (15 min)",
      "tasks": [
        "Mix Greek yogurt, light mayo, Dijon as the dressing base.",
        "Fold in already-shredded chicken breast, celery, red onion, halved grapes.",
        "Portion into 4 containers over a bed of the leftover arugula. Keep crackers/toast separate."
      ]
    },
    {
      "station": "Sunday \u2014 Chipotle Chicken Bowl Components (30 min)",
      "tasks": [
        "Cook jasmine rice, toss with cilantro and lime while warm.",
        "Char corn in a dry skillet. Make pico de gallo (tomato, onion, jalape\u00f1o, cilantro, lime).",
        "Warm black beans with a pinch of cumin. Make chipotle crema (light sour cream/yogurt + minced chipotle in adobo).",
        "Portion rice, beans, corn, pico, and the already-shredded chipotle chicken thigh into 6 containers \u2014 covers 3 dinners + 3 lunches."
      ]
    },
    {
      "station": "Saturday \u2014 Chickpeas & Dressings Prep (20 min)",
      "tasks": [
        "Roast chickpeas at 400\u00b0F for 15 min with olive oil, salt, smoked paprika until crisp.",
        "Make lemon-olive oil dressing (olive oil, lemon juice, Dijon, oregano) for Saturday's salad.",
        "Assemble the Mediterranean salad itself fresh Saturday evening rather than pre-portioning \u2014 arugula and chickpeas hold texture better that way."
      ]
    },
    {
      "station": "Sunday \u2014 Freezer Meal Check (5 min)",
      "tasks": [
        "Confirm which freezer protein you're pulling for Sunday's stir-fry (shrimp, ground turkey, or salmon all work at the same macros) and move it to the fridge Saturday night to thaw."
      ]
    }
  ]
